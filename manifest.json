{
  "manifest_version": 3,
  "name": "One-Click Auto Login",
  "version": "1.1",
  "description": "Fills and logs in automatically even from a new tab",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://firewall.7span.work/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png"
  }
}